[Unit]
Description=DCL Facilitator (Base mainnet, verify-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/dcl-facilitator
EnvironmentFile=/etc/dcl-facilitator/facilitator.env
ExecStart=/root/dcl-facilitator/target/release/dcl-facilitator
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/dcl-facilitator

[Install]
WantedBy=multi-user.target
