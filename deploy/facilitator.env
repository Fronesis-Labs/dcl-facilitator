# Verify-only Base mainnet. Config::from_env reads these names.
# The binary binds SocketAddr::new(HOST, PORT). Nothing else chooses the listen address.
# 8080 and 8081 are already taken on the Fronesis Labs VPS.
HOST=127.0.0.1
PORT=8095
RUST_LOG=info

# Base mainnet JSON-RPC. Chain id 8453 / eip155:8453 is fixed in the binary.
# There is no network selector and no Sepolia variable.
BASE_RPC_URL=https://mainnet.base.org

# Intentionally unset so /settle cannot sign or broadcast and recovery does not start:
#   DATABASE_PATH
#   SETTLER_KEY_FILE
#   SETTLER_MAX_FEE_PER_GAS
#   ORACLE_ADDRESS
# SETTLE_RECEIPT_TIMEOUT_SECS stays at the built-in 20 seconds.
