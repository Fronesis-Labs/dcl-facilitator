# Bind to loopback by default. Only widen this behind an authenticated proxy
# or an internal docker network.
HOST=127.0.0.1
PORT=8080
RUST_LOG=info

# Base mainnet JSON-RPC (eip155:8453, chain id 8453). No host is assumed.
# Required for /verify chain checks and for /settle.
# BASE_RPC_URL=https://mainnet.base.org

# SQLite file used by /settle and recovery.
# DATABASE_PATH=facilitator.db

# Absolute path to a hex-encoded 32-byte relayer key outside this repository.
# Set this together with SETTLER_MAX_FEE_PER_GAS. The key pays gas only.
# SETTLER_KEY_FILE=C:\keys\relayer.hex
# SETTLER_MAX_FEE_PER_GAS=1000000000

# Address whose signature must be on decisionEvidence. Required for /settle.
# ORACLE_ADDRESS=0x0000000000000000000000000000000000000000

# Receipt wait in seconds, from 1 to 120. Default is 20.
# SETTLE_RECEIPT_TIMEOUT_SECS=20
